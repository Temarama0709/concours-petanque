rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = UID listé ici (et dans src/admins.js), ou compte ayant reçu le
    // droit "admin" via la fonction setAdmin (functions/index.js).
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid in ['oQm4XO9c1xf8WaTcpvswIah52ur2']
            || request.auth.token.get('admin', false) == true);
    }

    // Formats : doit rester identique à src/lib/formats.js
    function isValidConcours(d) {
      return d.keys().hasOnly(['title', 'date', 'lieu', 'type', 'format', 'prix', 'ville', 'cp', 'valide', 'source', 'affiche', 'inscriptions', 'createdAt'])
        && d.get('affiche', false) is bool
        && d.get('inscriptions', false) is bool
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.lieu is string && d.lieu.size() > 0 && d.lieu.size() <= 200
        && d.ville is string && d.ville.size() > 0 && d.ville.size() <= 100
        && d.cp is string && d.cp.matches('^[0-9]{5}$')
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.type in ['officiel', 'ouvert']
        && d.format in ['Tete a tete Senior',
                        'Doublette Senior',
                        'Triplette Senior',
                        'Tete a tete Feminin',
                        'Doublette Feminin',
                        'Triplette Feminin',
                        'Doublette Mixte',
                        'Triplette Mixte',
                        'Tete a tete Veteran',
                        'Doublette Veteran',
                        'Triplette Veteran',
                        'Tete a tete Jeunes',
                        'Doublette Jeunes',
                        'Triplette Jeunes',
                        'Autre']
        && d.createdAt == request.time;
    }

    // Proposition du public : tarif obligatoire, toujours en attente de validation
    function isValidProposal(d) {
      return isValidConcours(d)
        && !('source' in d)
        && d.prix is number && d.prix >= 0 && d.prix <= 10000
        && d.valide == false;
    }

    // Ajout par un admin (formulaire ou import de calendrier) : tarif facultatif
    function isValidAdminConcours(d) {
      return isValidConcours(d)
        && d.get('source', 'admin') in ['admin', 'import']
        && (d.prix == null || (d.prix is number && d.prix >= 0 && d.prix <= 10000))
        && d.valide is bool;
    }

    match /concours/{id} {
      // Tout le monde voit les concours validés ; les admins voient aussi les propositions.
      allow read: if resource.data.valide == true || isAdmin();
      // Tout le monde peut proposer un concours, qui arrive non validé.
      // Les admins peuvent aussi publier directement (formulaire ou import).
      allow create: if isValidProposal(request.resource.data)
        || (isAdmin() && isValidAdminConcours(request.resource.data));
      // Seuls les admins valident, modifient ou suppriment.
      allow update, delete: if isAdmin();
    }


    // Affiche d'un concours (même identifiant), image JPEG en base64
    function isValidAffiche(d) {
      return d.keys().hasOnly(['image', 'createdAt'])
        && d.image is string && d.image.size() <= 900000
        && d.createdAt == request.time;
    }

    match /affiches/{id} {
      allow read: if isAdmin()
        || get(/databases/$(database)/documents/concours/$(id)).data.valide == true;
      // Le public ne peut joindre une affiche qu'en créant son concours dans le même envoi
      allow create: if isValidAffiche(request.resource.data)
        && (isAdmin()
            || (!exists(/databases/$(database)/documents/concours/$(id))
                && getAfter(/databases/$(database)/documents/concours/$(id)).data.valide == false));
      allow update: if isAdmin() && isValidAffiche(request.resource.data);
      allow delete: if isAdmin();
    }

    // E-mail de l'organisateur (même identifiant que le concours) : jamais lisible par le public
    function isValidContact(d) {
      return d.keys().hasOnly(['email', 'createdAt'])
        && d.email is string && d.email.size() <= 200
        && d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && d.createdAt == request.time;
    }

    match /contacts/{id} {
      allow read: if isAdmin();
      // Comme pour l'affiche : fourni uniquement à la création du concours
      allow create: if isValidContact(request.resource.data)
        && (isAdmin()
            || (!exists(/databases/$(database)/documents/concours/$(id))
                && getAfter(/databases/$(database)/documents/concours/$(id)).data.valide == false));
      allow update: if isAdmin() && isValidContact(request.resource.data);
      allow delete: if isAdmin();
    }

    // Inscriptions : tout le monde peut s'inscrire à un concours publié qui les accepte ;
    // seuls les admins (et le serveur, pour l'e-mail) peuvent les lire.
    function isValidInscription(d) {
      return d.keys().hasOnly(['concoursId', 'joueurs', 'club', 'telephone', 'email', 'createdAt'])
        && d.concoursId is string
        && d.joueurs is list && d.joueurs.size() >= 1 && d.joueurs.size() <= 4
        && d.joueurs[0] is string && d.joueurs[0].size() > 0 && d.joueurs[0].size() <= 80
        && d.club is string && d.club.size() <= 80
        && d.telephone is string && d.telephone.matches('^[0-9 +.]{6,20}$')
        && d.email is string && d.email.size() <= 200
        && (d.email == '' || d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$'))
        && d.createdAt == request.time;
    }

    match /inscriptions/{id} {
      allow read: if isAdmin();
      allow create: if isValidInscription(request.resource.data)
        && get(/databases/$(database)/documents/concours/$(request.resource.data.concoursId)).data.valide == true
        && get(/databases/$(database)/documents/concours/$(request.resource.data.concoursId)).data.get('inscriptions', false) == true;
      allow update, delete: if isAdmin();
    }
  }
}
