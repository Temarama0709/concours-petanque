rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = UID listé ici (et dans src/admins.js), ou compte ayant reçu le
    // droit "admin" via la fonction setAdmin (functions/index.js).
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid in ['oQm4XO9c1xf8WaTcpvswIah52ur2']
            || request.auth.token.get('admin', false) == true);
    }

    function chemin(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    // Compte contributeur de la personne connectée (créé par un admin)
    function estContributeur() {
      return request.auth != null && exists(chemin('contributeurs', request.auth.uid));
    }

    // Auteur d'un concours (contributeur qui l'a publié)
    function estAuteur(concoursId) {
      return request.auth != null
        && get(chemin('concours', concoursId)).data.get('auteur', '') == request.auth.uid;
    }

    // Formats : doit rester identique à src/lib/formats.js
    function isValidConcours(d) {
      return d.keys().hasOnly(['title', 'date', 'lieu', 'type', 'format', 'prix', 'ville', 'cp', 'clubId', 'clubNom', 'valide', 'source', 'auteur', 'affiche', 'inscriptions', 'createdAt'])
        && d.get('clubId', '') is string && d.get('clubId', '').size() <= 40
        && d.get('clubNom', '') is string && d.get('clubNom', '').size() <= 80
        && d.get('affiche', false) is bool
        && d.get('inscriptions', false) is bool
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.lieu is string && d.lieu.size() > 0 && d.lieu.size() <= 200
        && d.ville is string && d.ville.size() > 0 && d.ville.size() <= 100
        && d.cp is string && d.cp.matches('^[0-9]{5}$')
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.type in ['officiel', 'ouvert']
        && d.format in ['Tete a tete Senior',
                        'Doublette Senior',
                        'Triplette Senior',
                        'Tete a tete Feminin',
                        'Doublette Feminin',
                        'Triplette Feminin',
                        'Doublette Mixte',
                        'Triplette Mixte',
                        'Tete a tete Veteran',
                        'Doublette Veteran',
                        'Triplette Veteran',
                        'Tete a tete Jeunes',
                        'Doublette Jeunes',
                        'Triplette Jeunes',
                        'Autre']
        && d.createdAt == request.time;
    }

    // Publication par un contributeur : publiée directement, à son nom, tarif obligatoire
    function isValidConcoursContributeur(d) {
      return isValidConcours(d)
        && d.source == 'contributeur'
        && d.auteur == request.auth.uid
        && d.prix is number && d.prix >= 0 && d.prix <= 10000
        && d.valide == true;
    }

    // Le contributeur a un accès illimité, ou utilise 1 crédit dans le même envoi
    function paieLaPublication(concoursId) {
      let avant = get(chemin('contributeurs', request.auth.uid)).data;
      let apres = getAfter(chemin('contributeurs', request.auth.uid)).data;
      return avant.get('illimite', false) == true
        || (avant.credits >= 1
            && apres.credits == avant.credits - 1
            && apres.dernierConcours == concoursId);
    }

    // Ajout par un admin (formulaire ou import de calendrier) : tarif facultatif
    function isValidAdminConcours(d) {
      return isValidConcours(d)
        && !('auteur' in d)
        && d.get('source', 'admin') in ['admin', 'import']
        && (d.prix == null || (d.prix is number && d.prix >= 0 && d.prix <= 10000))
        && d.valide is bool;
    }

    match /concours/{id} {
      // Tout le monde voit les concours publiés ; les admins voient aussi les anciennes propositions.
      allow read: if resource.data.valide == true || isAdmin();
      // Publier est réservé aux admins et aux contributeurs (1 crédit par concours, sauf accès illimité).
      allow create: if (isAdmin() && isValidAdminConcours(request.resource.data))
        || (estContributeur()
            && isValidConcoursContributeur(request.resource.data)
            && paieLaPublication(id));
      allow update: if isAdmin();
      // Un contributeur peut supprimer ses propres concours.
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.get('auteur', '') == request.auth.uid);
    }

    // Comptes contributeurs : créés, crédités et retirés par un admin.
    // Le contributeur ne peut que retirer 1 crédit en publiant un nouveau concours.
    match /contributeurs/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'dernierConcours', 'updatedAt'])
            && request.resource.data.credits == resource.data.credits - 1
            && request.resource.data.updatedAt == request.time
            && !exists(chemin('concours', request.resource.data.dernierConcours))
            && getAfter(chemin('concours', request.resource.data.dernierConcours)).data.get('auteur', '') == uid);
    }

    // Demandes de compte contributeur (une par compte)
    function isValidDemande(d) {
      return d.keys().hasOnly(['email', 'nom', 'club', 'telephone', 'message', 'createdAt'])
        && d.email == request.auth.token.email
        && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 80
        && d.club is string && d.club.size() <= 80
        && d.telephone is string && d.telephone.matches('^[0-9 +.]{6,20}$')
        && d.message is string && d.message.size() <= 500
        && d.createdAt == request.time;
    }

    match /demandes/{uid} {
      allow read, delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && !exists(chemin('contributeurs', uid))
        && isValidDemande(request.resource.data);
    }

    // Affiche d'un concours (même identifiant), image JPEG en base64
    function isValidAffiche(d) {
      return d.keys().hasOnly(['image', 'createdAt'])
        && d.image is string && d.image.size() <= 900000
        && d.createdAt == request.time;
    }

    // Affiche ou e-mail ne peuvent être joints qu'en créant son propre concours, dans le même envoi
    function creeSonConcours(id) {
      return request.auth != null
        && !exists(chemin('concours', id))
        && getAfter(chemin('concours', id)).data.get('auteur', '') == request.auth.uid;
    }

    match /affiches/{id} {
      allow read: if isAdmin()
        || get(chemin('concours', id)).data.valide == true;
      allow create: if isValidAffiche(request.resource.data)
        && (isAdmin() || creeSonConcours(id));
      allow update: if isAdmin() && isValidAffiche(request.resource.data);
      allow delete: if isAdmin() || estAuteur(id);
    }

    // E-mail de l'organisateur (même identifiant que le concours) : jamais lisible par le public
    function isValidContact(d) {
      return d.keys().hasOnly(['email', 'createdAt'])
        && d.email is string && d.email.size() <= 200
        && d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && d.createdAt == request.time;
    }

    match /contacts/{id} {
      allow read: if isAdmin() || estAuteur(id);
      allow create: if isValidContact(request.resource.data)
        && (isAdmin() || creeSonConcours(id));
      allow update: if isAdmin() && isValidContact(request.resource.data);
      allow delete: if isAdmin() || estAuteur(id);
    }

    // Inscriptions : tout le monde peut s'inscrire à un concours publié qui les accepte,
    // avec au moins un téléphone ou un e-mail ; l'organisateur peut inscrire une équipe sur place.
    // Lecture : admins, auteur du concours (et le serveur, pour l'e-mail).
    function telephoneValide(t) {
      return t is string && t.matches('^[0-9 +.]{6,20}$');
    }
    function emailValide(e) {
      return e is string && e.size() <= 200 && e.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$');
    }
    function isValidInscription(d) {
      return d.keys().hasOnly(['concoursId', 'joueurs', 'club', 'telephone', 'email', 'uid', 'surPlace', 'presente', 'createdAt'])
        && d.concoursId is string
        && d.joueurs is list && d.joueurs.size() >= 1 && d.joueurs.size() <= 4
        && d.joueurs[0] is string && d.joueurs[0].size() > 0 && d.joueurs[0].size() <= 80
        && d.club is string && d.club.size() <= 80
        && d.telephone is string && (d.telephone == '' || telephoneValide(d.telephone))
        && d.email is string && (d.email == '' || emailValide(d.email))
        && d.createdAt == request.time;
    }
    function inscriptionPublique(d) {
      return isValidInscription(d)
        && (d.telephone != '' || d.email != '')
        && d.get('uid', null) == (request.auth == null ? null : request.auth.uid)
        && d.get('surPlace', false) == false
        && !('presente' in d)
        && get(chemin('concours', d.concoursId)).data.valide == true
        && get(chemin('concours', d.concoursId)).data.get('inscriptions', false) == true;
    }
    function inscriptionSurPlace(d) {
      return isValidInscription(d)
        && (isAdmin() || estAuteur(d.concoursId))
        && d.get('uid', null) == null
        && d.surPlace == true
        && d.get('presente', false) is bool;
    }

    match /inscriptions/{id} {
      allow read: if isAdmin() || estAuteur(resource.data.concoursId);
      allow create: if inscriptionPublique(request.resource.data) || inscriptionSurPlace(request.resource.data);
      // L'organisateur pointe les équipes présentes
      allow update: if isAdmin()
        || (estAuteur(resource.data.concoursId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['presente'])
            && request.resource.data.presente is bool);
      allow delete: if isAdmin() || estAuteur(resource.data.concoursId);
    }

    // Tournoi d'un concours (équipes, poules) : public en lecture, géré par l'organisateur
    match /tournois/{concoursId} {
      allow read: if true;
      allow create, update: if (isAdmin() || estAuteur(concoursId))
        && request.resource.data.statut in ['poules', 'finale', 'termine']
        && request.resource.data.format in ['poules', 'elimination']
        && request.resource.data.equipes is list
        && request.resource.data.nbTerrains is int
        && request.resource.data.pointsGagnants in [11, 13];
      allow delete: if isAdmin() || estAuteur(concoursId);

      // Parties : créées par l'organisateur ; les équipes connectées saisissent leurs scores
      match /parties/{partieId} {
        allow read: if true;
        allow create, delete: if isAdmin() || estAuteur(concoursId);
        allow update: if isAdmin() || estAuteur(concoursId) || saisieJoueur();

        function scoresValides(d) {
          return d.scoreA is int && d.scoreB is int
            && d.scoreA >= 0 && d.scoreB >= 0 && d.scoreA <= 13 && d.scoreB <= 13
            && d.scoreA != d.scoreB;
        }
        function camp() {
          return request.auth == null ? ''
            : request.auth.uid == resource.data.uidA ? 'A'
            : request.auth.uid == resource.data.uidB ? 'B'
            : '';
        }
        function saisieJoueur() {
          let avant = resource.data;
          let apres = request.resource.data;
          let moi = camp();
          let adverseConnecte = (moi == 'A' ? avant.uidB : avant.uidA) != null;
          return moi != ''
            && avant.equipeB != null
            && avant.statut != 'validee'
            && apres.diff(avant).affectedKeys().hasOnly(['scoreA', 'scoreB', 'statut', 'saisiePar', 'updatedAt'])
            && apres.updatedAt == request.time
            && (
              // Proposer (ou corriger) un score
              (apres.saisiePar == moi && scoresValides(apres)
                && apres.statut == (adverseConnecte ? 'en_attente' : 'validee'))
              // Confirmer le score proposé par l'adversaire
              || (avant.statut == 'en_attente' && avant.saisiePar != moi
                  && apres.saisiePar == avant.saisiePar
                  && apres.scoreA == avant.scoreA && apres.scoreB == avant.scoreB
                  && apres.statut == 'validee')
            );
        }
      }
    }

    // Paiements Stripe : écrits uniquement par le serveur (webhookStripe)
    match /paiements/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Clubs proposés à la création de compte : lisibles par tous, gérés par l'admin
    match /clubs/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['nom', 'ville', 'adresse', 'departement', 'createdAt', 'updatedAt'])
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 80
        && request.resource.data.get('ville', '') is string && request.resource.data.get('ville', '').size() <= 60
        && request.resource.data.get('adresse', '') is string && request.resource.data.get('adresse', '').size() <= 200
        && request.resource.data.departement is string && request.resource.data.departement.matches('^[0-9]{2}[AB0-9]?$');
      allow delete: if isAdmin();
    }

    // Contact des clubs (téléphone, responsable) : données personnelles, admins uniquement
    match /clubsPrives/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['telephone', 'responsable', 'updatedAt'])
        && request.resource.data.telephone is string && (request.resource.data.telephone == '' || request.resource.data.telephone.matches('^[0-9 +.]{6,20}$'))
        && request.resource.data.responsable is string && request.resource.data.responsable.size() <= 80;
    }

    // Profil de chaque compte (club d'affiliation) : modifiable par la personne elle-même
    match /utilisateurs/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'affilie', 'departement', 'clubId', 'clubNom', 'clubAVerifier', 'updatedAt'])
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.affilie is bool
        && request.resource.data.departement is string && request.resource.data.departement.size() <= 3
        && request.resource.data.clubId is string && request.resource.data.clubId.size() <= 40
        && request.resource.data.clubNom is string && request.resource.data.clubNom.size() <= 80
        && request.resource.data.clubAVerifier is bool
        && (request.resource.data.clubId == ''
            || request.resource.data.clubId.matches('^defaut-[0-9AB]{2,3}-[0-9]{1,4}$')
            || exists(chemin('clubs', request.resource.data.clubId)))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
  }
}
