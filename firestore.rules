rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = UID listé ici (et dans src/admins.js), ou compte ayant reçu le
    // droit "admin" via la fonction setAdmin (functions/index.js).
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid in ['oQm4XO9c1xf8WaTcpvswIah52ur2']
            || request.auth.token.get('admin', false) == true);
    }

    function chemin(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    // Compte contributeur de la personne connectée (créé par un admin)
    function estContributeur() {
      return request.auth != null && exists(chemin('contributeurs', request.auth.uid));
    }

    // Auteur d'un concours (contributeur qui l'a publié)
    function estAuteur(concoursId) {
      return request.auth != null
        && get(chemin('concours', concoursId)).data.get('auteur', '') == request.auth.uid;
    }

    // Formats : doit rester identique à src/lib/formats.js
    function isValidConcours(d) {
      return d.keys().hasOnly(['title', 'date', 'lieu', 'type', 'format', 'prix', 'ville', 'cp', 'valide', 'source', 'auteur', 'affiche', 'inscriptions', 'createdAt'])
        && d.get('affiche', false) is bool
        && d.get('inscriptions', false) is bool
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.lieu is string && d.lieu.size() > 0 && d.lieu.size() <= 200
        && d.ville is string && d.ville.size() > 0 && d.ville.size() <= 100
        && d.cp is string && d.cp.matches('^[0-9]{5}$')
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.type in ['officiel', 'ouvert']
        && d.format in ['Tete a tete Senior',
                        'Doublette Senior',
                        'Triplette Senior',
                        'Tete a tete Feminin',
                        'Doublette Feminin',
                        'Triplette Feminin',
                        'Doublette Mixte',
                        'Triplette Mixte',
                        'Tete a tete Veteran',
                        'Doublette Veteran',
                        'Triplette Veteran',
                        'Tete a tete Jeunes',
                        'Doublette Jeunes',
                        'Triplette Jeunes',
                        'Autre']
        && d.createdAt == request.time;
    }

    // Publication par un contributeur : publiée directement, à son nom, tarif obligatoire
    function isValidConcoursContributeur(d) {
      return isValidConcours(d)
        && d.source == 'contributeur'
        && d.auteur == request.auth.uid
        && d.prix is number && d.prix >= 0 && d.prix <= 10000
        && d.valide == true;
    }

    // Le contributeur a un accès illimité, ou utilise 1 crédit dans le même envoi
    function paieLaPublication(concoursId) {
      let avant = get(chemin('contributeurs', request.auth.uid)).data;
      let apres = getAfter(chemin('contributeurs', request.auth.uid)).data;
      return avant.get('illimite', false) == true
        || (avant.credits >= 1
            && apres.credits == avant.credits - 1
            && apres.dernierConcours == concoursId);
    }

    // Ajout par un admin (formulaire ou import de calendrier) : tarif facultatif
    function isValidAdminConcours(d) {
      return isValidConcours(d)
        && !('auteur' in d)
        && d.get('source', 'admin') in ['admin', 'import']
        && (d.prix == null || (d.prix is number && d.prix >= 0 && d.prix <= 10000))
        && d.valide is bool;
    }

    match /concours/{id} {
      // Tout le monde voit les concours publiés ; les admins voient aussi les anciennes propositions.
      allow read: if resource.data.valide == true || isAdmin();
      // Publier est réservé aux admins et aux contributeurs (1 crédit par concours, sauf accès illimité).
      allow create: if (isAdmin() && isValidAdminConcours(request.resource.data))
        || (estContributeur()
            && isValidConcoursContributeur(request.resource.data)
            && paieLaPublication(id));
      allow update: if isAdmin();
      // Un contributeur peut supprimer ses propres concours.
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.get('auteur', '') == request.auth.uid);
    }

    // Comptes contributeurs : créés, crédités et retirés par un admin.
    // Le contributeur ne peut que retirer 1 crédit en publiant un nouveau concours.
    match /contributeurs/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'dernierConcours', 'updatedAt'])
            && request.resource.data.credits == resource.data.credits - 1
            && request.resource.data.updatedAt == request.time
            && !exists(chemin('concours', request.resource.data.dernierConcours))
            && getAfter(chemin('concours', request.resource.data.dernierConcours)).data.get('auteur', '') == uid);
    }

    // Demandes de compte contributeur (une par compte)
    function isValidDemande(d) {
      return d.keys().hasOnly(['email', 'nom', 'club', 'telephone', 'message', 'createdAt'])
        && d.email == request.auth.token.email
        && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 80
        && d.club is string && d.club.size() <= 80
        && d.telephone is string && d.telephone.matches('^[0-9 +.]{6,20}$')
        && d.message is string && d.message.size() <= 500
        && d.createdAt == request.time;
    }

    match /demandes/{uid} {
      allow read, delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && !exists(chemin('contributeurs', uid))
        && isValidDemande(request.resource.data);
    }

    // Affiche d'un concours (même identifiant), image JPEG en base64
    function isValidAffiche(d) {
      return d.keys().hasOnly(['image', 'createdAt'])
        && d.image is string && d.image.size() <= 900000
        && d.createdAt == request.time;
    }

    // Affiche ou e-mail ne peuvent être joints qu'en créant son propre concours, dans le même envoi
    function creeSonConcours(id) {
      return request.auth != null
        && !exists(chemin('concours', id))
        && getAfter(chemin('concours', id)).data.get('auteur', '') == request.auth.uid;
    }

    match /affiches/{id} {
      allow read: if isAdmin()
        || get(chemin('concours', id)).data.valide == true;
      allow create: if isValidAffiche(request.resource.data)
        && (isAdmin() || creeSonConcours(id));
      allow update: if isAdmin() && isValidAffiche(request.resource.data);
      allow delete: if isAdmin() || estAuteur(id);
    }

    // E-mail de l'organisateur (même identifiant que le concours) : jamais lisible par le public
    function isValidContact(d) {
      return d.keys().hasOnly(['email', 'createdAt'])
        && d.email is string && d.email.size() <= 200
        && d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && d.createdAt == request.time;
    }

    match /contacts/{id} {
      allow read: if isAdmin() || estAuteur(id);
      allow create: if isValidContact(request.resource.data)
        && (isAdmin() || creeSonConcours(id));
      allow update: if isAdmin() && isValidContact(request.resource.data);
      allow delete: if isAdmin() || estAuteur(id);
    }

    // Inscriptions : tout le monde peut s'inscrire à un concours publié qui les accepte ;
    // seuls les admins, l'auteur du concours (et le serveur, pour l'e-mail) peuvent les lire.
    function isValidInscription(d) {
      return d.keys().hasOnly(['concoursId', 'joueurs', 'club', 'telephone', 'email', 'createdAt'])
        && d.concoursId is string
        && d.joueurs is list && d.joueurs.size() >= 1 && d.joueurs.size() <= 4
        && d.joueurs[0] is string && d.joueurs[0].size() > 0 && d.joueurs[0].size() <= 80
        && d.club is string && d.club.size() <= 80
        && d.telephone is string && d.telephone.matches('^[0-9 +.]{6,20}$')
        && d.email is string && d.email.size() <= 200
        && (d.email == '' || d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$'))
        && d.createdAt == request.time;
    }

    match /inscriptions/{id} {
      allow read: if isAdmin() || estAuteur(resource.data.concoursId);
      allow create: if isValidInscription(request.resource.data)
        && get(chemin('concours', request.resource.data.concoursId)).data.valide == true
        && get(chemin('concours', request.resource.data.concoursId)).data.get('inscriptions', false) == true;
      allow update: if isAdmin();
      allow delete: if isAdmin() || estAuteur(resource.data.concoursId);
    }

    // Paiements Stripe : écrits uniquement par le serveur (webhookStripe)
    match /paiements/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
  }
}
